<Window x:Class="ActDefend.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:local="clr-namespace:ActDefend.GUI"
        Title="ActDefend — Ransomware Early Warning"
        Height="680" Width="980"
        MinHeight="520" MinWidth="760"
        Background="{StaticResource PrimaryBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!-- Inverse boolean to visibility: true -> Collapsed, false -> Visible -->
        <Style x:Key="ProtectedBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#1a3a1a"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="6,2"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- Tray icon with right-click context menu -->
        <tb:TaskbarIcon x:Name="TaskbarIcon"
                        IconSource="/ActDefend.GUI;component/Images/shield.ico"
                        ToolTipText="ActDefend — Ransomware Monitor"
                        TrayMouseDoubleClick="TaskbarIcon_TrayMouseDoubleClick"
                        TrayRightMouseUp="TaskbarIcon_TrayRightMouseUp">
        </tb:TaskbarIcon>

        <!-- Title bar -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" Padding="16,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="⛨" FontSize="22" Margin="0,0,10,0" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="ActDefend" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                <TextBlock Text=" — Ransomware Early Warning System" FontSize="13" Foreground="#888" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Status sidebar -->
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Text="SYSTEM STATUS" FontSize="11" FontWeight="Bold" Foreground="#666" Margin="0,0,0,8"/>

                <Border CornerRadius="6" Padding="12" Margin="0,0,0,8" Background="{StaticResource SurfaceBrush}">
                    <StackPanel>
                        <TextBlock Text="ELEVATION" FontSize="10" Foreground="#888"/>
                        <TextBlock Text="{Binding ElevationText}" FontSize="14" FontWeight="Bold"
                                   Foreground="{Binding ElevationBrush}"/>
                    </StackPanel>
                </Border>

                <Border CornerRadius="6" Padding="12" Margin="0,0,0,8" Background="{StaticResource SurfaceBrush}">
                    <StackPanel>
                        <TextBlock Text="COLLECTOR" FontSize="10" Foreground="#888"/>
                        <TextBlock Text="{Binding CollectorText}" FontSize="14" FontWeight="Bold"
                                   Foreground="{Binding CollectorBrush}"/>
                    </StackPanel>
                </Border>

                <Border CornerRadius="6" Padding="12" Margin="0,0,0,8" Background="{StaticResource SurfaceBrush}">
                    <StackPanel>
                        <TextBlock Text="EVENTS PROCESSED" FontSize="10" Foreground="#888"/>
                        <TextBlock Text="{Binding EventsProcessed}" FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"/>
                    </StackPanel>
                </Border>

                <Border CornerRadius="6" Padding="12" Margin="0,0,0,8" Background="{StaticResource SurfaceBrush}">
                    <StackPanel>
                        <TextBlock Text="TRACKED PROCESSES" FontSize="10" Foreground="#888"/>
                        <TextBlock Text="{Binding TrackedProcesses}" FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"/>
                    </StackPanel>
                </Border>

                <Border CornerRadius="6" Padding="12" Margin="0,0,0,8" Background="{StaticResource SurfaceBrush}">
                    <StackPanel>
                        <TextBlock Text="EVENTS DROPPED" FontSize="10" Foreground="#888"/>
                        <TextBlock Text="{Binding EventsDropped}" FontSize="14" FontWeight="Bold"
                                   Foreground="{Binding DroppedBrush}"/>
                    </StackPanel>
                </Border>

                <Border CornerRadius="6" Padding="12" Margin="0,0,0,8" Background="{StaticResource SurfaceBrush}">
                    <StackPanel>
                        <TextBlock Text="UPTIME" FontSize="10" Foreground="#888"/>
                        <TextBlock Text="{Binding UptimeText}" FontSize="13" FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Main Content Tabs -->
            <TabControl Grid.Column="1" Background="Transparent" BorderThickness="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border Name="Border" Padding="12,6" Margin="0,0,4,0"
                                            Background="{StaticResource SurfaceBrush}" CornerRadius="4,4,0,0">
                                        <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center"
                                                          HorizontalAlignment="Center" ContentSource="Header" Margin="10,2"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#333"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="False">
                                            <Setter TargetName="Border" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                    </Style>
                </TabControl.Resources>

                <!-- ═══ Tab 1: Recent Alerts ═══ -->
                <TabItem Header="RECENT ALERTS">
                    <Border CornerRadius="0,4,4,4" Background="{StaticResource SurfaceBrush}" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="ALERTS FEED" FontSize="11" FontWeight="Bold"
                                           Foreground="#666" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding AlertCountText}" FontSize="11"
                                           Foreground="#555" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <ListView Grid.Row="1" ItemsSource="{Binding RecentAlerts}"
                                      Background="Transparent" BorderThickness="0"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1a1a2e" CornerRadius="4" Padding="10,8"
                                                Margin="0,0,0,6"
                                                BorderBrush="{Binding SeverityBrush}" BorderThickness="3,0,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <Border Background="{Binding SeverityBrush}" CornerRadius="2"
                                                                Padding="4,1" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding SeverityLabel}" FontWeight="Bold"
                                                                       Foreground="#111" FontSize="9"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding ProcessName}" FontWeight="Bold"
                                                                   Foreground="{StaticResource AccentBrush}" FontSize="13"
                                                                   Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding PidText}" Foreground="#555" FontSize="11"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Summary}" Foreground="{StaticResource TextBrush}"
                                                               TextWrapping="Wrap" FontSize="12" Margin="0,0,0,4"/>
                                                    <TextBlock Text="{Binding EvidenceSummary}" Foreground="#666"
                                                               TextWrapping="Wrap" FontSize="10" Margin="0,0,0,8"/>

                                                    <!-- Allow button: blue-green, clearly positive, with tooltip -->
                                                    <Button Content="✓  Trust this process"
                                                            Command="{Binding DataContext.AllowProcessFromAlertCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                                            CommandParameter="{Binding}"
                                                            HorizontalAlignment="Left"
                                                            Padding="10,4"
                                                            Background="#0e4d3a"
                                                            Foreground="#4ecca3"
                                                            BorderBrush="#4ecca3"
                                                            BorderThickness="1"
                                                            FontSize="11"
                                                            FontWeight="SemiBold"
                                                            Cursor="Hand"
                                                            ToolTip="Add this process to Trusted Processes — it will no longer be monitored by ActDefend"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding TimestampText}"
                                                           Foreground="#666" FontSize="11"
                                                           VerticalAlignment="Top" Margin="12,0,0,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </TabItem>

                <!-- ═══ Tab 2: Trusted Processes / Allowlist ═══ -->
                <TabItem Header="ALLOWLIST">
                    <Border CornerRadius="0,4,4,4" Background="{StaticResource SurfaceBrush}" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <StackPanel Grid.Row="0" Margin="0,0,0,6">
                                <TextBlock Text="TRUSTED PROCESSES / ALLOWLIST" FontSize="12" FontWeight="Bold"
                                           Foreground="#aaa"/>
                                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#888" Margin="0,4,0,0"
                                           Text="Trusted processes are completely ignored by the detection pipeline. Only add applications you fully trust. Default system exclusions are protected and cannot be removed."/>
                            </StackPanel>

                            <Separator Grid.Row="1" Background="#333" Margin="0,6,0,12"/>

                            <!-- Add entry form -->
                            <Border Grid.Row="2" Background="#1a1a2e" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="ADD TRUSTED PROCESS" FontSize="10" FontWeight="Bold"
                                               Foreground="#666" Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding NewAllowlistProcessName, UpdateSourceTrigger=PropertyChanged}"
                                                 Padding="6,5" Margin="0,0,8,0"
                                                 Background="#0d0d1a" Foreground="#eee" BorderBrush="#444"
                                                 ToolTip="Process name (e.g. backup.exe)">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="Tag" Value="Process name (e.g. backup.exe)"/>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                        <Button Grid.Column="1"
                                                Content="Add Process"
                                                Command="{Binding AddAllowlistEntryCommand}"
                                                Padding="14,6"
                                                Background="#0e4d3a" Foreground="#4ecca3"
                                                BorderBrush="#4ecca3" BorderThickness="1"
                                                FontWeight="SemiBold" Cursor="Hand"/>
                                    </Grid>
                                    <TextBlock Text="Process Name" FontSize="9" Foreground="#555" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Search/filter bar -->
                            <Grid Grid.Row="3" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding AllowlistFilterText, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="6,5" Background="#1a1a2e" Foreground="#eee" BorderBrush="#333"
                                         ToolTip="Filter by process name"/>
                                <TextBlock Grid.Column="1" Text="🔍 Filter" Foreground="#666" FontSize="11"
                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>

                            <!-- Allowlist items -->
                            <Grid Grid.Row="4">
                                <!-- Empty state message -->
                                <TextBlock Text="{Binding AllowlistEmptyMessage}"
                                           Foreground="#555" FontSize="12" FontStyle="Italic"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextWrapping="Wrap" TextAlignment="Center" Margin="24">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AllowlistIsEmpty}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <ListView ItemsSource="{Binding Allowlist}"
                                          Background="Transparent" BorderThickness="0"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#1a1a2e" CornerRadius="4" Padding="10,8" Margin="0,0,0,5">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="160"/>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Process name -->
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding ProcessName}"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource AccentBrush}"
                                                               FontSize="12" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding ProcessName}"/>

                                                    <!-- Source badge -->
                                                    <Border Grid.Column="1" CornerRadius="3" Padding="5,2"
                                                            Margin="4,0" VerticalAlignment="Center"
                                                            HorizontalAlignment="Left">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#1a2a3a"/>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding Source}" FontSize="9"
                                                                   Foreground="#7ab" FontWeight="Bold"/>
                                                    </Border>

                                                    <!-- Added date -->
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding TimestampText}"
                                                               Foreground="#666" FontSize="10"
                                                               VerticalAlignment="Center" Margin="4,0"/>

                                                    <!-- Reason/notes -->
                                                    <TextBlock Grid.Column="3"
                                                               Text="{Binding Reason}"
                                                               Foreground="#888" FontSize="10"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Reason}"
                                                               Margin="4,0,8,0"/>

                                                    <!-- Action: Remove button for user-added, PROTECTED badge for defaults -->
                                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <!-- PROTECTED badge for default entries -->
                                                        <Border CornerRadius="3" Padding="6,2" Background="#1a3a1a"
                                                                ToolTip="This is a built-in system exclusion and cannot be removed.">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding CanRemove}" Value="False">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="PROTECTED" FontSize="9" FontWeight="Bold" Foreground="#4a8a4a"/>
                                                        </Border>

                                                        <!-- Remove button for user-added entries -->
                                                        <Button Content="Remove"
                                                                Command="{Binding DataContext.RemoveAllowlistEntryCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                                                CommandParameter="{Binding}"
                                                                Visibility="{Binding CanRemove, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                VerticalAlignment="Center"
                                                                Padding="10,4"
                                                                Background="#2d0e0e" Foreground="#e05555"
                                                                BorderBrush="#e05555" BorderThickness="1"
                                                                FontSize="11" FontWeight="SemiBold"
                                                                Cursor="Hand"
                                                                ToolTip="Remove this process from the trusted list — it will be monitored again"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Grid>
                    </Border>
                </TabItem>

                <!-- ═══ Tab 3: Settings / Tuning ═══ -->
                <TabItem Header="SETTINGS / TUNING">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Border CornerRadius="0,4,4,4" Background="{StaticResource SurfaceBrush}" Padding="16">
                            <StackPanel>
                                <!-- Header -->
                                <TextBlock Text="APPLICATION CONFIGURATION" FontSize="12" FontWeight="Bold" Foreground="#aaa" Margin="0,0,0,6"/>
                                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#888" Margin="0,0,0,16"
                                           Text="Tune the detection pipeline. Changing advanced settings may affect detection accuracy and performance."/>

                                <!-- Profile Selection -->
                                <Border Background="#151b22" BorderBrush="#30363d" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Preset Profiles" FontWeight="Bold" Foreground="#eee" Margin="0,0,0,8"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Button Content="Balanced" Command="{Binding Settings.ApplyProfileCommand}" CommandParameter="Balanced" Width="90" Height="24" Margin="0,0,8,0" Background="#21262d" Foreground="#c9d1d9"/>
                                            <Button Content="Sensitive" Command="{Binding Settings.ApplyProfileCommand}" CommandParameter="Sensitive" Width="90" Height="24" Margin="0,0,8,0" Background="#21262d" Foreground="#c9d1d9"/>
                                            <Button Content="Low Resource" Command="{Binding Settings.ApplyProfileCommand}" CommandParameter="LowResource" Width="100" Height="24" Margin="0,0,8,0" Background="#21262d" Foreground="#c9d1d9"/>
                                            <Button Content="Conservative" Command="{Binding Settings.ApplyProfileCommand}" CommandParameter="Conservative" Width="90" Height="24" Margin="0,0,8,0" Background="#21262d" Foreground="#c9d1d9"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Settings.CurrentProfileDescription}" FontSize="11" Foreground="#8b949e" FontStyle="Italic"/>
                                    </StackPanel>
                                </Border>

                                <!-- Advanced Settings Grid -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left Column -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Stage 1 Settings" FontWeight="Bold" Foreground="#ccc" Margin="0,0,0,8"/>
                                        <UniformGrid Columns="2" Margin="0,0,0,16">
                                            <TextBlock Text="Suspicion Threshold:" Foreground="#aaa" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding Settings.Stage1SuspicionThreshold, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,2"/>

                                            <TextBlock Text="WriteRate Weight:" Foreground="#aaa" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding Settings.Stage1WeightWriteRate, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,2"/>

                                            <TextBlock Text="UniqueFiles Weight:" Foreground="#aaa" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding Settings.Stage1WeightUniqueFilesWritten, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,2"/>

                                            <TextBlock Text="RenameRate Weight:" Foreground="#aaa" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding Settings.Stage1WeightRenameRate, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,2"/>

                                            <TextBlock Text="DirSpread Weight:" Foreground="#aaa" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding Settings.Stage1WeightDirectorySpread, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,2"/>

                                            <TextBlock Text="PreExistMod Weight:" Foreground="#aaa" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding Settings.Stage1WeightPreExistingModifyRate, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,2"/>
                                        </UniformGrid>

                                        <TextBlock Text="Feature Windows" FontWeight="Bold" Foreground="#ccc" Margin="0,0,0,8"/>
                                        <UniformGrid Columns="2" Margin="0,0,0,16">
                                            <TextBlock Text="Primary Window (s):" Foreground="#aaa" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding Settings.FeaturesPrimaryWindowSeconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,2"/>

                                            <TextBlock Text="Context Window (s):" Foreground="#aaa" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding Settings.FeaturesContextWindowSeconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,2"/>

                                            <TextBlock Text="Emit Interval (s):" Foreground="#aaa" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding Settings.FeaturesEmitIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,2"/>

                                            <TextBlock Text="Inactivity Expiry (s):" Foreground="#aaa" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding Settings.FeaturesInactivityExpirySeconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,2"/>
                                        </UniformGrid>
                                    </StackPanel>

                                    <!-- Right Column -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Stage 2 Settings" FontWeight="Bold" Foreground="#ccc" Margin="0,0,0,8"/>
                                        <UniformGrid Columns="2" Margin="0,0,0,16">
                                            <TextBlock Text="Entropy Threshold:" Foreground="#aaa" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding Settings.Stage2EntropyThreshold, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,2"/>

                                            <TextBlock Text="Max Files To Sample:" Foreground="#aaa" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding Settings.Stage2MaxFilesToSample, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,2"/>

                                            <TextBlock Text="Min Confirm Files:" Foreground="#aaa" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding Settings.Stage2ConfirmationMinFiles, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,2"/>

                                            <TextBlock Text="Cooldown (s):" Foreground="#aaa" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding Settings.Stage2CooldownSeconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,2"/>
                                        </UniformGrid>

                                        <TextBlock Text="Collector Settings" FontWeight="Bold" Foreground="#ccc" Margin="0,0,0,8"/>
                                        <UniformGrid Columns="2" Margin="0,0,0,16">
                                            <TextBlock Text="Event Queue Cap:" Foreground="#aaa" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding Settings.CollectorEventQueueCapacity, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,2"/>
                                        </UniformGrid>
                                    </StackPanel>
                                </Grid>

                                <Border Background="#151b22" BorderBrush="#30363d" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,16,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Settings.ValidationErrorMessage}" Foreground="#ff7b72" FontWeight="Bold" FontSize="11" Margin="0,0,0,4"
                                                       Visibility="{Binding Settings.ValidationErrorMessage, Converter={local:StringToVisibilityConverter}}"/>
                                            <TextBlock Text="Settings saved. Please restart ActDefend for changes to take effect." Foreground="#3fb950" FontWeight="Bold" FontSize="11"
                                                       Visibility="{Binding Settings.IsRestartRequired, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        </StackPanel>

                                        <Button Grid.Column="1" x:Name="SettingsRestartButton" Content="Restart ActDefend" Click="SettingsRestartButton_Click"
                                                Width="120" Height="26" Margin="0,0,12,0" Background="#1f6feb" Foreground="#ffffff" FontWeight="Bold" BorderThickness="0"/>
                                        <Button Grid.Column="2" Content="Reset to Defaults" Command="{Binding Settings.ResetToDefaultsCommand}"
                                                Width="120" Height="26" Margin="0,0,12,0" Background="#21262d" Foreground="#e05555" BorderBrush="#e05555"/>
                                        <Button Grid.Column="3" Content="Save Settings" Command="{Binding Settings.SaveSettingsCommand}"
                                                Width="120" Height="26" Background="#238636" Foreground="#ffffff" FontWeight="Bold" BorderThickness="0"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" Padding="12,0">
            <TextBlock Text="{Binding StatusBarText}" FontSize="11" Foreground="#666" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
